# Frontend Environment Configuration
# Copy this file to .env.production and update for production deployment

# Backend API URL
# Local: http://localhost:8080
# Production: https://your-render-app-name.onrender.com
VITE_API_URL=https://resume-builder-and-skill-gap-analyzer-dtqz.onrender.com

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_REDIRECT_URI=http://localhost:5173/login

# Production (uncomment and update for production)
# VITE_API_URL=https://your-backend-domain.com
# VITE_GOOGLE_CLIENT_ID=your_actual_google_client_id.apps.googleusercontent.com
# VITE_GITHUB_CLIENT_ID=your_actual_github_client_id
# VITE_GITHUB_REDIRECT_URI=https://your-domain.com/login
